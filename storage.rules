rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product imagery: public read; write restricted to staff with image content-type
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // General showroom assets
    match /showroom/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
