rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check admin role
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }
    
    // Helper function to check staff role (Admin or Shop Manager)
    function isStaff() {
      return isAuthenticated() && (
        getUserData().role in ['admin', 'shop_manager'] ||
        isAdmin()
      );
    }

    // Public active products readable by anyone; writes restricted to authorized staff
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    // Staff accounts: readable by staff; create/update/delete strictly by Admin
    match /users/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Business settings: readable by all visitors; writable only by Admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
